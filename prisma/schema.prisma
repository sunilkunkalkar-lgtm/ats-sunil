generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recruiter {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  ownedCandidates Candidate[]    @relation("CandidateOwner")
  ownedRoles      Role[]         @relation("RoleOwner")
  applications    Application[]
  activities      ActivityLog[]
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  roles     Role[]
}

enum RolePriority {
  NEW_PROJECT
  BACKFILL
}

enum RoleStatus {
  OPEN
  FILLED
  CANCELLED
}

model Role {
  id         String       @id @default(cuid())
  title      String
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  priority   RolePriority
  status     RoleStatus   @default(OPEN)
  slaDays    Int          @default(21)
  openedAt   DateTime     @default(now())
  headcount  Int          @default(1)
  ownerId    String
  owner      Recruiter    @relation("RoleOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now())
  applications Application[]
}

enum PipelineStatus {
  SOURCED
  CONTACTED
  INTERVIEWING
  OFFERED
  ACCEPTED
  JOINED
  OFFER_DROPOFF
}

enum DropoffReason {
  COUNTER_OFFER
  GHOSTED
  SALARY_MISMATCH
  ACCEPTED_ELSEWHERE
  PERSONAL
  OTHER
}

model Candidate {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String   @unique
  ownerId   String
  owner     Recruiter @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  activities   ActivityLog[]
}

model Application {
  id             String          @id @default(cuid())
  candidateId    String
  roleId         String
  status         PipelineStatus  @default(SOURCED)
  dropoffReason  DropoffReason?
  dropoffNotes   String?
  recruiterId    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  candidate  Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  recruiter  Recruiter    @relation(fields: [recruiterId], references: [id], onDelete: Restrict)
  activities ActivityLog[]

  @@unique([candidateId, roleId])
  @@index([roleId, status])
  @@index([status])
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  OUTREACH
  STATUS_CHANGE
  DUPLICATE_BLOCK
}

model ActivityLog {
  id            String       @id @default(cuid())
  candidateId   String
  applicationId String?
  recruiterId   String
  type          ActivityType
  body          String
  createdAt     DateTime     @default(now())

  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  recruiter   Recruiter    @relation(fields: [recruiterId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
}
